{
  "name": "dsh-ballast",
  "version": "0.2.4",
  "description": "DSH Web 上下文窗口归因面板：通过 host token meter 按消息显示当前 surface 的 token 占用与摘要。Read-only per-message context-window attribution for DSH Web using the host token meter.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run dock:check && node --test test/*.test.js",
    "dock:sync": "dsh-mini-utility-dock sync lib/client.js",
    "dock:check": "dsh-mini-utility-dock check lib/client.js",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "dsh-mini-utility-dock": "0.1.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "ballast",
    "summary": "按消息计量当前 surface 的 token 占用，提供类型聚合与跨会话 Top；只读，不修改会话或触发 compaction。",
    "categories": ["dev", "Web UI"],
    "surfaces": ["host", "web"],
    "capabilities": {},
    "compatibility": {
      "dsh": ">=0.1.2-alpha.2",
      "node": ">=20"
    },
    "permissions": {
      "network": ["http://127.0.0.1:*"],
      "os": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-ballast.git"
  },
  "homepage": "https://github.com/xswt442-cmd/dsh-ballast#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/dsh-ballast/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "token-meter",
    "context-window",
    "attribution"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
