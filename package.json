{
  "name": "dsh-ballast",
  "version": "0.2.10",
  "description": "DSH Web 上下文窗口归因面板：通过 host token meter 按消息显示当前 surface 的 token 占用与摘要。Read-only per-message context-window attribution for DSH Web using the host token meter.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "npm run dock:check && npm run guard:check && npm run loopback:check && node --test test/*.test.js",
    "dock:sync": "dsh-mini-utility-dock sync lib/client.js",
    "dock:check": "dsh-mini-utility-dock check lib/client.js",
    "loopback:sync": "dsh-mini-utility-dock sync lib/shared.js",
    "guard:sync": "dsh-mini-utility-dock sync lib/shared.js",
    "loopback:check": "dsh-mini-utility-dock check lib/shared.js",
    "guard:check": "dsh-mini-utility-dock check lib/shared.js",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "dsh-mini-utility-dock": "0.1.7"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-ballast.git"
  },
  "homepage": "https://github.com/xswt442-cmd/dsh-ballast#readme",
  "bugs": {
    "url": "https://github.com/xswt442-cmd/dsh-ballast/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "dsh-plugin",
    "token-meter",
    "context-window",
    "attribution"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
